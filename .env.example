# Copy to `.env` and fill in. `.env` is gitignored.
#
# Required only for live experiment runs. Every offline path — task validation,
# fault determinism tests, the replay cache, and `chaosagent report` — works
# without an API key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default trace store location.
# CHAOSAGENT_TRACE_DB=traces/chaosagent.duckdb

# Optional: override the default response cache directory.
# CHAOSAGENT_CACHE_DIR=traces/cache
